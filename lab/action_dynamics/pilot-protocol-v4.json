  "trajectory": {
    "point_count": 108,
    "sample_period_seconds": 0.25,
    "minimum_clean_context_windows": 20,
    "onset_index_min": 28,
    "onset_index_max": 39,
    "duration_min": 8,
    "duration_max": 20,
    "minimum_recovery_windows": 48,
    "action_at_t_predicts_state": "t+1"
  },
