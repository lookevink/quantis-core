    "eligible_event_trace_link_rate_min": 0.95,
    "eligible_completed_checkout_path_rate_min": 0.95,
    "cross_case_trace_reference_count_max": 0,
    "truth_exclusion_required": true,
    "forbidden_observation_fields": [
