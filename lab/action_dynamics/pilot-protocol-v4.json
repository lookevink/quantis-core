  "analysis": {
    "embedded_v4_split_semantics": "compatibility_only_not_authorization_for_model_fit",
    "authoritative_corpus_role": "instrumentation_pilot",
    "primary_unit": "matched_pair",
    "active_effect_statistic": "median_paired_treatment_minus_control_except_api_rejection_uses_pooled_exact_count_rate_difference",
    "effect_sign_is_applied_before_threshold": true,
    "recovery_statistic": "non_enqueue_actions_use_final_eight_states; enqueue_delay_uses_median_absolute_paired_delta_over_sixteen_continuous_workload_states_after_two_post_stop_washout_states_divided_by_max_absolute_active_effect_or_feature_floor",
    "cold_restart_probe_role": "diagnostic_and_liveness_only_not_intervention_recovery",
