  },
  "design": {
    "design_kind": "complete_action_topology_factorial",
    "action_kinds": [
      "worker_pause",
      "postgres_lock",
      "redis_enqueue_delay",
      "redis_dequeue_delay",
      "api_rejection"
    ],
    "worker_replica_values": [
      1,
      2,
      3
    ],
    "replicates_per_cell": 2,
    "pair_count": 30,
    "severity_assignment": "For actions with three severities, severity_index=(topology_index+replicate_index) mod 3, where topology_index is 0,1,2 and replicate_index is 0,1. PostgreSQL lock always uses 1.0.",
    "onset_duration_assignment": "Draw independently without replacement within each action family from the inclusive protocol ranges using generator_seed before capture; API rejection uses fixed duration 20; reject and redraw only combinations leaving fewer than 48 recovery windows.",
    "request_schedule_assignment": "Materialize one explicit 108-value schedule before capture and copy it byte-for-byte to both twins; API rejection uses exactly 12 requests per transition, and enqueue delay uses the frozen drain and probe tail.",
    "factor_order_before_randomization": [
      "action_kind",
      "worker_replicas",
      "replicate"
    ]
  },
  "scheduling": {
    "lane_count": 6,
    "batch_count": 5,
    "pairs_per_batch": 6,
    "lane_assignment": "After deterministic seeded permutation, pair ordinal modulo 6.",
    "batch_assignment": "After deterministic seeded permutation, floor(pair ordinal divided by 6).",
    "twins_run_sequentially_in_lane": true,
    "twin_wave_barrier": true,
    "treatment_first_for_even_pair_ordinal": true,
    "fresh_project_between_twins": true,
    "application_image_built_once_before_collection": true,
    "action_and_topology_balance_checked_before_capture": true
  },
  "retry_policy": {
