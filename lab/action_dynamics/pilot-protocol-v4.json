  "claim": {
    "supported": "On the fixed Quantis checkout lab, the content-addressed concurrent harness executes five predeclared reversible intervention/location families across 30 randomized matched treatment/control pairs and one-, two-, and three-worker topologies with aligned commands, preregistered observable effects, recovery, trace-linked request paths, and isolated capture.",
    "excluded": [
      "forecasting skill",
      "independent target localization",
      "graph topology benefit",
      "causal attribution outside the finite randomized intervention library",
      "production transfer",
      "a software world model"
    ],
    "failure_outcome": "A failed gate is retained as a bounded negative instrumentation result and blocks the open development corpus until the relevant action adapter, telemetry path, isolation mechanism, or protocol is revised under a new version."
  }
