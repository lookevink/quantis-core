{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantis.dev/contracts/otlp-feature-spec.v1.schema.json",
  "title": "Quantis OTLP feature specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "window_period_nano", "features"],
  "properties": {
    "schema_version": {"const": 1},
    "window_period_nano": {"type": "integer", "minimum": 1},
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "metric_name",
          "statistic",
          "resource_attributes",
          "point_attributes"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "metric_name": {"type": "string", "minLength": 1},
          "statistic": {
            "enum": [
              "gauge_last",
              "sum_rate",
              "histogram_mean",
              "histogram_count_rate"
            ]
          },
          "resource_attributes": {"$ref": "#/$defs/attributeFilter"},
          "point_attributes": {"$ref": "#/$defs/attributeFilter"}
        }
      }
    }
  },
  "$defs": {
    "attributeFilter": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean"]
      }
    }
  }
}
